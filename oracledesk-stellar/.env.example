# Copy to .env and fill in. Never commit the real file (it's gitignored).
# Testnet only — nothing here should ever point at mainnet or hold real funds.

# --- Stellar network -----------------------------------------------------
# The agents validate everything below at startup (agents/core/config.ts) and
# report every problem at once. `npm run trader -- --print-config` prints the
# resolved config with secrets redacted and exits without network access.
#
# STELLAR_NETWORK: testnet (default when unset) | futurenet | local | mainnet.
# STELLAR_NETWORK_PASSPHRASE is optional; if set it must equal the canonical
# passphrase for STELLAR_NETWORK or startup fails:
#   testnet   "Test SDF Network ; September 2015"
#   futurenet "Test SDF Future Network ; October 2022"
#   local     "Standalone Network ; February 2017"
#   mainnet   "Public Global Stellar Network ; September 2015"
# STELLAR_RPC_URL defaults per network (testnet https://soroban-testnet.stellar.org,
# futurenet https://rpc-futurenet.stellar.org, local http://localhost:8000/soroban/rpc).
# Mainnet has no default and must be set explicitly.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Portion of each trading fee kept by the protocol treasury (bps), set on
# market-core at deploy time. The remainder accrues to the market creator
# and is claimable before resolution (see docs/architecture.md). 10000
# keeps everything protocol-side, matching pre-#8 deployments.
PROTOCOL_FEE_SHARE_BPS=10000

# Identities used by scripts/deploy-testnet.sh, scripts/seed-market.sh, and
# the agents (see agents/stellar/). Generate with:
#   stellar keys generate oracledesk-deployer --network testnet --fund
#   stellar keys generate oracledesk-agent --network testnet --fund
DEPLOYER_IDENTITY=oracledesk-deployer
AGENT_IDENTITY=oracledesk-agent

# --- Treasury (scripts/deploy-testnet.sh) -----------------------------------
# The treasury keeps a registry of agents, each with roles and its own
# sub-budget under the global caps. deploy-testnet.sh registers the
# constructor agent (oracledesk-agent, all roles) plus a maker
# (oracledesk-maker: create + settle) and a trader (oracledesk-trader:
# trade + settle). Adding agents is a loosening change, so the maker and
# trader go live only after CONFIG_DELAY: re-run the deploy script then.
# CONFIG_DELAY=86400
# MAKER_MAX_TRADE=2000000000
# MAKER_MAX_DAILY=5000000000
# TRADER_MAX_TRADE=2000000000
# TRADER_MAX_DAILY=5000000000

# --- Deployed contract addresses ------------------------------------------
# Populated by scripts/deploy-testnet.sh into deployments/<network>.json.
# The agents read deployments/<STELLAR_NETWORK>.json unless DEPLOYMENTS_FILE
# (or its older alias DEPLOYMENTS_PATH; if both are set they must match) names
# another record. The record is schema-checked: deployer, agent (and optional
# agents.maker / agents.trader) must be G... keys, and contracts.usdc,
# market_core, resolver, treasury and reasoning_registry must all be present
# C... ids, or the record is reported as stale. A record without a "network"
# field is treated as testnet; one with it must match STELLAR_NETWORK.
# DEPLOYMENTS_FILE=deployments/local.json
#
# Each *_CONTRACT_ID below, when set to a C... id, replaces that contract in
# the record after validation, and startup logs the override. Blank = unset.
# MARKET_CORE_CONTRACT_ID=
# RESOLVER_CONTRACT_ID=
# TREASURY_CONTRACT_ID=
# REASONING_REGISTRY_CONTRACT_ID=
# USDC_CONTRACT_ID=

# --- x402 trace API (x402/) ------------------------------------------------
PORT=3001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
TRACE_PRICE_USDC=0.01
# Policy for flagged or revoked traces: "refuse" (410 before payment) or "label" (include verdict)
TRACE_VERDICT_POLICY=refuse
# Static fallback trace records; prefer the reasoning-registry-backed
# repository once REASONING_REGISTRY_CONTRACT_ID is set (see x402/server.ts).
TRACE_RECORDS_JSON=[]
TESTNET_SERVER_STELLAR_ADDRESS=
TESTNET_FACILITATOR_URL=
TESTNET_FACILITATOR_API_KEY=
# Test-harness only: serve registry-backed traces without the x402 payment
# middleware. scripts/e2e-local.sh sets this; never enable it on a paid host.
# PAYMENTS_DISABLED=0
# <!-- TODO(maintainer): confirm the x402-on-Stellar testnet facilitator URL
# to use here; none is hardcoded anywhere in this repo. -->

# --- Agents (agents/) -------------------------------------------------------
# Numbers are parsed strictly: base-10 integers only. A variable that is set
# but empty, fractional, negative, NaN, hex or out of range fails startup;
# only an unset variable takes its default.
#
# AGENT_MODE: "dry-run" (default only when unset; never signs or submits) or
# "live" (real transactions). Any other value, including "", is rejected.
AGENT_MODE=dry-run
# Market the trader agent reads and trades (see agents/stellar/adapter.ts).
MARKET_ID=0
# Which price the trader compares to its fair-value estimate:
#   spot = market-core's instantaneous `get_price` (moves with any trade)
#   twap = the manipulation-resistant time-weighted average over
#          TWAP_WINDOW_SECS, read via market-core's `twap` view
PRICE_SOURCE=spot
TWAP_WINDOW_SECS=900
# Signing keys (S...). Each CLI prefers its own role key and falls back to
# the shared AGENT_SECRET_KEY: bin/market-maker.ts uses MAKER_SECRET_KEY,
# bin/trader.ts TRADER_SECRET_KEY. Live mode requires one, and its public key
# must equal the role's address in the deployment record (agents.maker /
# agents.trader, else agent). Dry-run never passes the key to the adapter.
# Blank = unset; a non-blank value must be a valid S... key in either mode.
AGENT_SECRET_KEY=
MAKER_SECRET_KEY=
TRADER_SECRET_KEY=
# Startup probes check that STELLAR_RPC_URL serves STELLAR_NETWORK's
# passphrase and that every contract in the record exists and is not
# archived. Mandatory in live mode (failure stops startup); best effort in
# dry-run (failures are warnings). `--offline` skips them, in dry-run only.
# Timeout per probe, 1-600000 ms:
AGENT_STARTUP_PROBE_TIMEOUT_MS=5000
# Trader. MIN_EDGE_BPS: 0-10000 (default 500). TRADE_SIZE_STROOPS: 1 up to
# the i128 maximum (default 100000000 = 10 USDC). FAIR_VALUE_BPS: 0-10000;
# unset = each market's own price (no external oracle is wired in yet).
# MIN_EDGE_BPS=500
# TRADE_SIZE_STROOPS=100000000
# FAIR_VALUE_BPS=
# Execution bounds for real trades. The trader quotes first, then sends
# min_shares_out / limit_price_bps derived from the quote: SLIPPAGE_BPS
# (0-10000) is how far below the quoted average price the fill may land,
# DEADLINE_SECS (1-86400) is how long the signed trade stays valid.
SLIPPAGE_BPS=50
DEADLINE_SECS=60
# Market maker. CONFIDENCE_THRESHOLD_BPS: 0-10000 (default 1000).
# DEFAULT_SEED_STROOPS: at least 1000000000 (100 USDC; default 1500000000).
# MARKET_CLOSE_IN_SECS: 1 to one year (default 3600).
# CONFIDENCE_THRESHOLD_BPS=1000
# DEFAULT_SEED_STROOPS=1500000000
# MARKET_CLOSE_IN_SECS=3600
# Where reasoning traces are written (non-empty path, default ./.traces).
# TRACE_STORE_DIR=./.traces
#
# Event triggers for `npm run trader -- --follow` (#105). The trader polls
# contract events and re-evaluates only the markets they point at.
#   EVENTS_STATE_DIR: checkpoints + dead-letter.jsonl, one checkpoint file
#     per network and contract set (default ./.events, gitignored).
#   EVENTS_TRADE_THRESHOLD: a trade of at least this many stroops queues its
#     market for re-evaluation (default 500000000 = 50 USDC).
#   EVENTS_POLL_INTERVAL_MS: 100-3600000 (default 10000).
#   EVENTS_PAGE_LIMIT: events per getEvents page, 1-10000 (default 100).
#   EVENTS_CONCURRENCY: markets handled in parallel, 1-64 (default 4).
#   EVENTS_MAX_ATTEMPTS: tries per handler before dead-lettering, 1-100 (default 5).
#   EVENTS_DISPUTE_WINDOW_SECS: dispute window used for proposal alerts (default 600).
# EVENTS_STATE_DIR=./.events
# EVENTS_TRADE_THRESHOLD=500000000
#
# Cross-market arbitrage (#108), run by the trader when ARB_ENABLED=1 (or
# true). See docs/architecture.md, "Cross-market arbitrage". Dry-run only
# plans and logs; live trades both legs sequentially.
#   ARB_RELATIONS_FILE: required when enabled; JSON list of relations.
#   ARB_JOURNAL_FILE: crash-recovery journal (default ./.arb/journal.jsonl).
#   ARB_MAX_NOTIONAL: most one plan may spend across both legs, stroops (default 1000000000).
#   ARB_MIN_PROFIT_STROOPS: smallest guaranteed profit worth trading (default 1000000).
#   ARB_MIN_PROFIT_BPS: smallest profit as a share of cost, 0-10000 (default 50).
#   ARB_MAX_UNHEDGED_STROOPS: cap on the first leg, left naked if the second fails (default 500000000).
#   ARB_MARKET_HEADROOM_BPS: share of each market's max_market kept free, 0-9999 (default 2000).
#   ARB_MAX_LEG_LOSS: how much more the second leg may cost than planned before unwinding (default 10000000).
#   ARB_MAX_OPEN_LEGS: arbitrage legs in flight at once, 2-64 (default 2).
#   ARB_MAX_UNWIND_RETRIES: attempts to sell back a stranded first leg, 1-20 (default 3).
# ARB_ENABLED=0
# ARB_RELATIONS_FILE=./arb-relations.json
#
# Mainnet interlock. The agents refuse STELLAR_NETWORK=mainnet unless ALL of:
#   - STELLAR_NETWORK_PASSPHRASE is the public network passphrase (or unset),
#   - STELLAR_RPC_URL is set explicitly,
#   - the deployment file is not testnet.json,
#   - the deployment record declares "network": "mainnet",
#   - AGENT_ALLOW_MAINNET is exactly I_ACCEPT_REAL_FUNDS_
# Every unmet condition is reported. Leave this unset on testnet.
# AGENT_ALLOW_MAINNET=

# x402: strict startup by default; false drops unavailable networks from accepts.
X402_REQUIRE_ALL_NETWORKS=true
X402_TRACE_LOAD_TIMEOUT_MS=10000
X402_MAX_TIMEOUT_SECONDS=60
X402_FACILITATOR_TIMEOUT_MS=5000
# SQLite is durable; memory is only for ephemeral development/test sessions.
X402_LEDGER=sqlite
X402_LEDGER_PATH=./.x402-ledger.sqlite
# Optional support endpoint GET /admin/payments/:paymentId (Bearer token).
# Disabled when unset. Generate a strong random token; never commit it.
X402_ADMIN_TOKEN=
# Ledger-bound Stellar envelopes need a live ledger anchor (no payment submitted).
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_MAINNET_RPC_URL=https://soroban.stellar.org
