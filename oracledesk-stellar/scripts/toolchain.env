# Backward-compatible shim: delegates to `oracledesk-stellar/toolchain.env`,
# the single source of truth for pinned toolchain versions (#135).
_TOOLCHAIN_SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../toolchain.env
source "${_TOOLCHAIN_SHIM_DIR}/../toolchain.env"
