    "@oracledesk/bindings-treasury": "file:../../packages/bindings/treasury",
    "@stellar/stellar-sdk": "^16.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3"
  }
