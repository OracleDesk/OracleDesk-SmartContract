# Single source of truth for pinned OracleDesk development and CI toolchains (#135).
#
# Checked for drift against:
#   - oracledesk-stellar/rust-toolchain.toml
#   - oracledesk-stellar/stellar-cli.version
#   - .devcontainer/Dockerfile
#   - flake.nix
#
# Run `make check-toolchain-sync` (or `./scripts/check-toolchain-sync.sh`) after
# any version bump.

RUST_VERSION=1.93.1
RUST_WASM_TARGET=wasm32v1-none
NIGHTLY_TOOLCHAIN=nightly-2026-11-10
STELLAR_CLI_VERSION=27.1.0
NODE_VERSION=24.13.1
PYTHON_VERSION=3.12
PYTHON_MIN_VERSION=3.10
JQ_VERSION=1.7.1

# Release binary SHA-256 digests for stellar-cli v27.1.0 (x86_64 and arm64 Linux).
# Update alongside STELLAR_CLI_VERSION from:
#   https://github.com/stellar/stellar-cli/releases/tag/v27.1.0
STELLAR_CLI_SHA256_X86_64=9915fe63753d7154c26bb9e6410cf1d1ff9727a9b378e663c2790ab7a266af94
STELLAR_CLI_SHA256_ARM64=750a8dcda225fab33c87fa0d0dc79936266ed62cd316245fba234f18aab385bd
