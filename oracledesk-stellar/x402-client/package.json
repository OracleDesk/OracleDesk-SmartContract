{
  "name": "@oracledesk/x402-client",
  "version": "1.0.0",
  "description": "Isomorphic TypeScript x402 buyer client for OracleDesk traces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify.js",
      "types": "./dist/verify.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node init && tsc",
    "test": "node --test --experimental-vm-modules dist/**/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.3"
  },
  "engines": {
    "node": ">=20"
  }
}
