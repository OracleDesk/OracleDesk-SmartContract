  "errors": {
    "Error": {
      "kind": "udt_error_enum_v0",
      "spec": {
        "cases": [
          {
            "doc": "The envelope named a different network or market-core.",
            "name": "DomainMismatch",
            "value": 3
          },
          {
            "doc": "A `price`/`signers` config failed the resolver's own validation rules.",
            "name": "InvalidConfig",
            "value": 2
          },
          {
            "doc": "`buy_and_publish_trace` was given empty trace content.",
            "name": "InvalidTrace",
            "value": 4
          },
          {
            "doc": "",
            "name": "NotInitialized",
            "value": 1
          },
          {
            "doc": "The router was asked to reveal a rule variant it does not support.",
            "name": "UnsupportedRule",
            "value": 5
          }
        ],
        "doc": "",
        "lib": "",
