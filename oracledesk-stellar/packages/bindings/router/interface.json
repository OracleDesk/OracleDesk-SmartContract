{
  "schema": 1,
  "contract": "router",
  "functions": {
    "__constructor": {
      "kind": "function_v0",
      "spec": {
        "doc": "Stores the address book once, at deploy time. There is no privileged role and the values never change, so this is not admin-gated.",
        "inputs": [
          {
            "doc": "",
            "name": "market_core",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "resolver",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "reasoning_registry",
            "type_": {
              "option": {
                "value_type": "address"
              }
            }
          }
        ],
        "name": "__constructor",
        "outputs": []
      }
    },
    "buy_and_publish_trace": {
      "kind": "function_v0",
      "spec": {
        "doc": "Buys `outcome` shares through market-core and publishes a reasoning trace through the reasoning registry in the same transaction, so a trace cannot be skipped after a trade. The registry must be configured.",
        "inputs": [
          {
            "doc": "",
            "name": "trader",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "market_id",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "outcome",
            "type_": {
              "udt": {
                "name": "Outcome"
              }
            }
          },
          {
            "doc": "",
            "name": "collateral_in",
            "type_": "i128"
          },
          {
            "doc": "",
            "name": "min_shares_out",
            "type_": "i128"
          },
          {
            "doc": "",
            "name": "action",
            "type_": "string"
          },
          {
            "doc": "",
            "name": "trace_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "ipfs_cid",
            "type_": "string"
          }
        ],
        "name": "buy_and_publish_trace",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "u64"
            }
          }
        ]
      }
    },
    "config": {
      "kind": "function_v0",
      "spec": {
        "doc": "",
        "inputs": [],
        "name": "config",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": {
                "udt": {
                  "name": "RouterConfig"
                }
              }
            }
          }
        ]
      }
    },
    "create_and_reveal_price": {
      "kind": "function_v0",
      "spec": {
        "doc": "See [`Router::create_and_reveal_signers`] — same flow, price rule.",
        "inputs": [
          {
            "doc": "",
            "name": "creator",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "question_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "meta_uri",
            "type_": "string"
          },
          {
            "doc": "",
            "name": "category",
            "type_": {
              "udt": {
                "name": "Category"
              }
            }
          },
          {
            "doc": "",
            "name": "close_time",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "seed_amount",
            "type_": "i128"
          },
          {
            "doc": "",
            "name": "initial_yes_bps",
            "type_": "u32"
          },
          {
            "doc": "",
            "name": "spec_v2",
            "type_": {
              "udt": {
                "name": "ResolutionSpecV2"
              }
            }
          }
        ],
        "name": "create_and_reveal_price",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "u64"
            }
          }
        ]
      }
    },
    "create_and_reveal_signers": {
      "kind": "function_v0",
      "spec": {
        "doc": "Creates a market and reveals its signer-mode rule in one transaction. The commitment is computed from `spec_v2` locally and passed to market-core, so the reveal necessarily matches.",
        "inputs": [
          {
            "doc": "",
            "name": "creator",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "question_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "meta_uri",
            "type_": "string"
          },
          {
            "doc": "",
            "name": "category",
            "type_": {
              "udt": {
                "name": "Category"
              }
            }
          },
          {
            "doc": "",
            "name": "close_time",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "seed_amount",
            "type_": "i128"
          },
          {
            "doc": "",
            "name": "initial_yes_bps",
            "type_": "u32"
          },
          {
            "doc": "",
            "name": "spec_v2",
            "type_": {
              "udt": {
                "name": "ResolutionSpecV2"
              }
            }
          }
        ],
        "name": "create_and_reveal_signers",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "u64"
            }
          }
        ]
      }
    },
    "reveal_spec": {
      "kind": "function_v0",
      "spec": {
        "doc": "Reveals a spec the creator committed to in a previous transaction (ADR 0001's commit-now/reveal-later path). Kept here so a creator can use one contract for both the atomic and the deferred flows.",
        "inputs": [
          {
            "doc": "",
            "name": "market_id",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "spec_v2",
            "type_": {
              "udt": {
                "name": "ResolutionSpecV2"
              }
            }
          }
        ],
        "name": "reveal_spec",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "void"
            }
          }
        ]
      }
    }
  },
