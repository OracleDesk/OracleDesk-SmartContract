    "schedule": {
      "kind": "function_v0",
      "spec": {
        "doc": "Schedules `target.fn_name(args)`. The proposer must hold the proposer role; the effective delay is the larger of the global floor and any `(target, fn_name)` override.",
        "inputs": [
          {
            "doc": "",
            "name": "target",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "fn_name",
            "type_": "symbol"
          },
          {
            "doc": "",
            "name": "args",
            "type_": {
              "vec": {
                "element_type": "val"
              }
            }
          }
        ],
        "name": "schedule",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "u64"
            }
          }
        ]
      }
    },
    "set_default_delay": {
      "kind": "function_v0",
      "spec": {
        "doc": "Sets the global delay floor. Increasing it must go through the timelock itself (schedule a self-call), so an operator cannot quietly extend every in-flight delay; decreasing it is a normal admin action.",
        "inputs": [
          {
            "doc": "",
            "name": "delay",
            "type_": "u64"
          }
        ],
        "name": "set_default_delay",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "void"
            }
          }
        ]
      }
    },
    "set_delay": {
      "kind": "function_v0",
      "spec": {
        "doc": "Sets or clears a `(target, fn_name)` delay override.",
        "inputs": [
          {
            "doc": "",
            "name": "target",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "fn_name",
            "type_": "symbol"
          },
          {
            "doc": "",
            "name": "delay",
            "type_": {
              "option": {
                "value_type": "u64"
              }
            }
          }
        ],
        "name": "set_delay",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "void"
            }
          }
        ]
      }
    },
    "set_roles": {
      "kind": "function_v0",
      "spec": {
        "doc": "Sets the roles. Admin action (redirect it through `schedule` in production so operators cannot silently swap each other).",
