          }
        ],
        "name": "delay_for",
        "outputs": [
          "u64"
        ]
      }
    },
    "emergency": {
      "kind": "function_v0",
      "spec": {
        "doc": "Bypasses the delay for a small allow-list of safety calls. The `emergency` role must be configured and hold auth.",
        "inputs": [
          {
            "doc": "",
            "name": "target",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "fn_name",
            "type_": "symbol"
          },
          {
            "doc": "",
            "name": "args",
