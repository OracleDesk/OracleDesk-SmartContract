          },
          {
            "doc": "",
            "name": "published_at",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "trace_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          }
        ],
        "lib": "",
        "name": "Trace"
      }
    }
