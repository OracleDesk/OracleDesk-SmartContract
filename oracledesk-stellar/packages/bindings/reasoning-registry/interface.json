  "errors": {
    "Error": {
      "kind": "udt_error_enum_v0",
      "spec": {
        "cases": [
          {
            "doc": "",
            "name": "AgentAlreadyRegistered",
            "value": 3
          },
          {
            "doc": "",
            "name": "AgentNotRegistered",
            "value": 4
          },
          {
            "doc": "`expected_seq` / `prev_trace_hash` don't extend the agent's chain head (#52).",
            "name": "ChainHeadMismatch",
            "value": 8
          },
          {
            "doc": "Agent already has a chain, so unchained `publish_trace` is refused (#52).",
            "name": "ChainedAgentMustChain",
            "value": 9
          },
          {
            "doc": "",
            "name": "EmptyAction",
            "value": 6
          },
          {
            "doc": "",
            "name": "EmptyCid",
            "value": 7
          },
          {
            "doc": "`accept_admin`/`cancel_admin_transfer` called with nothing proposed.",
            "name": "NoPendingAdmin",
            "value": 11
          },
          {
            "doc": "",
            "name": "NotInitialized",
            "value": 1
          },
          {
            "doc": "A proposed admin handover was not accepted within its `expires_at`.",
            "name": "PendingAdminExpired",
            "value": 12
          },
          {
            "doc": "Trace already backed an action (#50).",
            "name": "TraceAlreadyConsumed",
            "value": 10
          },
          {
            "doc": "",
            "name": "TraceNotFound",
            "value": 5
          },
          {
            "doc": "",
            "name": "Unauthorized",
            "value": 2
          }
        ],
        "doc": "",
        "lib": "",
        "name": "Error"
      }
    }
  },
