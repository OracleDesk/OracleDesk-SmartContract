  "types": {
    "ChainHead": {
      "kind": "udt_struct_v0",
      "spec": {
        "doc": "Head of an agent's append-only trace log (#52). Genesis is `seq = 0` with an all-zero hash.",
        "fields": [
          {
            "doc": "",
            "name": "head_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "head_trace_id",
            "type_": {
              "option": {
                "value_type": "u64"
              }
            }
          },
          {
            "doc": "",
            "name": "seq",
            "type_": "u64"
          }
