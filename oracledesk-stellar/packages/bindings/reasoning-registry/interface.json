    },
    "publish_chained_trace": {
      "kind": "function_v0",
      "spec": {
        "doc": "Publishes a trace that extends `agent`'s hash chain (#52). Fails with `ChainHeadMismatch` unless `expected_seq == head.seq + 1` and `prev_trace_hash == head.head_hash`, so a skipped decision shows up as a gap and a fork is impossible.",
        "inputs": [
          {
            "doc": "",
            "name": "agent",
            "type_": "address"
          },
          {
            "doc": "",
            "name": "market_id",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "action",
            "type_": "string"
          },
          {
            "doc": "",
            "name": "trace_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          },
          {
            "doc": "",
            "name": "ipfs_cid",
            "type_": "string"
          },
          {
            "doc": "",
            "name": "expected_seq",
            "type_": "u64"
          },
          {
            "doc": "",
            "name": "prev_trace_hash",
            "type_": {
              "bytes_n": {
                "n": 32
              }
            }
          }
        ],
        "name": "publish_chained_trace",
        "outputs": [
          {
            "result": {
              "error_type": "error",
              "ok_type": "u64"
            }
          }
        ]
      }
    },
    "publish_trace": {
      "kind": "function_v0",
      "spec": {
        "doc": "",
        "inputs": [
          {
            "doc": "",
            "name": "agent",
            "type_": "address"
          },
