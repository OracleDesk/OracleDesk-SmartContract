    },
    "DataKey": {
      "kind": "udt_union_v0",
      "spec": {
        "cases": [
          {
            "void_v0": {
              "doc": "",
              "name": "Admin"
            }
          },
          {
            "tuple_v0": {
              "doc": "",
              "name": "Agent",
              "type_": [
                "address"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Per-agent hash-chain head (#52).",
              "name": "AgentHead",
              "type_": [
                "address"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Per-agent `seq -> trace_id` (#52).",
              "name": "AgentTrace",
              "type_": [
                "address",
                "u64"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Set once a trace has backed an action (#50).",
              "name": "Consumed",
              "type_": [
                "u64"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Contracts allowed to call `consume_trace` (#50).",
              "name": "Consumer",
              "type_": [
                "address"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "",
              "name": "MarketTrace",
              "type_": [
                "u64",
                "u64"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Number of traces published for a market, so a client can page through `MarketTrace(market_id, 0..count)` without the contract ever holding an unbounded Vec of trace ids in one storage entry.",
              "name": "MarketTraceCount",
              "type_": [
                "u64"
              ]
            }
          },
          {
            "void_v0": {
              "doc": "",
              "name": "NextId"
            }
          },
          {
            "void_v0": {
              "doc": "",
              "name": "PendingAdmin"
            }
          },
          {
            "tuple_v0": {
              "doc": "",
              "name": "Trace",
              "type_": [
                "u64"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "Ledger sequence a trace was written in (#50). Kept beside `Trace` rather than inside it so the `Trace` XDR shape doesn't change.",
              "name": "TraceLedger",
              "type_": [
                "u64"
              ]
            }
          },
          {
            "tuple_v0": {
              "doc": "`trace_id -> ChainLink`; absent for legacy traces (#52).",
              "name": "TraceLink",
              "type_": [
                "u64"
              ]
            }
          }
        ],
        "doc": "",
        "lib": "",
        "name": "DataKey"
      }
    },
    "PendingAdmin": {
      "kind": "udt_struct_v0",
      "spec": {
        "doc": "A proposed admin handover (#62). Absent when no transfer is pending.",
