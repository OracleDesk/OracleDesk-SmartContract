{
  "name": "@oracledesk/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsx --test core/*.test.ts stellar/*.test.ts bin/*.test.ts runtime/*.test.ts",
    "market-maker": "tsx bin/market-maker.ts",
    "trader": "tsx bin/trader.ts",
    "agentd": "tsx bin/agentd.ts"
    "test": "tsx --test core/*.test.ts stellar/*.test.ts bin/*.test.ts sim/*.test.ts",
    "market-maker": "tsx bin/market-maker.ts",
    "trader": "tsx bin/trader.ts",
    "coverage": "c8 --all --src . --reporter=lcovonly --reporter=text-summary --report-dir ../coverage/agents --exclude '**/*.test.ts' --exclude 'node_modules/**' --exclude 'dist/**' --exclude '**/*.d.ts' tsx --test core/*.test.ts stellar/*.test.ts bin/*.test.ts"
  },
  "dependencies": {
    "@oracledesk/bindings-market-core": "file:../packages/bindings/market-core",
    "@oracledesk/bindings-reasoning-registry": "file:../packages/bindings/reasoning-registry",
    "@oracledesk/bindings-resolver": "file:../packages/bindings/resolver",
    "@oracledesk/bindings-treasury": "file:../packages/bindings/treasury",
    "@stellar/stellar-sdk": "^16.0.1",
    "dotenv": "^17.4.2",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "c8": "^12.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.8.3"
  }
}
